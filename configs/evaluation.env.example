# Source with: set -a; source configs/evaluation.env.example; set +a
# Pass the shared HF export explicitly through --model / --model_path.
TENSOR_PARALLEL_SIZE=1
BIRD_DEV_DATA=/path/to/bird/dev.json
BIRD_TABLES=/path/to/bird/dev_tables.json
BIRD_DB_PATH=/path/to/bird/dev_databases
BIRD_DB_CONTENT_INDEX_PATH=/path/to/bird/db_contents_index
SPIDER_DATA_DIR=/path/to/spider_data
SPIDER_SOURCE=/path/to/spider_data
# Optional robustness workspace; defaults to PROJECT/.runs/robustness/data.
# DATA_DIR=/path/to/robustness/data
